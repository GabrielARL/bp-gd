# Scientific packet/candidate artifacts are reproducible local run products.
# Some state and LLR buffers exceed GitHub's per-object limit; publish the
# compact score directories, committed result reports, source, and cards.
results/**/packet/
results/**/candidate/
results/**/coarse_packet/
results/**/coarse_candidate/
results/**/fine_packet/
results/**/fine_candidate/

# Local proposal previews and the copied NUS-branded deck are retained outside
# the public repository. The canonical standalone paper remains versioned.
paper/proposals/
paper/closing_gradient_route/
